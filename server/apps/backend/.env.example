# Numina Backend 配置模板
# 复制此文件为 .env 并根据环境修改配置

# =============================================================================
# 基础配置
# =============================================================================

# 运行环境: development / production
ENVIRONMENT=development

# 统一数据根目录（所有数据文件的基础路径）
# 本地开发默认: ~/.numina/data
# Docker 部署: /app/.numina/data（由 docker-compose.yml 注入）
# 所有子路径（数据库、上传、日志等）均从此目录派生，除非单独覆盖
DATA_ROOT=~/.numina/data

# JWT 密钥（生产环境必填，开发环境自动生成）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库连接字符串
# 默认从 DATA_ROOT 派生: sqlite:///{DATA_ROOT}/db/numina.db
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/database
# 显式设置此值会覆盖 DATA_ROOT 派生的默认值
DATABASE_URL=

# =============================================================================
# JWT Token 配置
# =============================================================================

# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15

# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 儿童 PIN 码 bcrypt 轮数（较低以保持性能）
PIN_BCRYPT_ROUNDS=8

# 儿童会话刷新令牌有效期（天，约10年）
CHILD_REFRESH_TOKEN_EXPIRE_DAYS=3650

# =============================================================================
# WebAuthn 配置（无密码登录）
# =============================================================================

# 域名（不含协议和端口）
WEBAUTHN_RP_ID=localhost

# 应用名称
WEBAUTHN_RP_NAME=Numina

# 完整来源（含协议）
WEBAUTHN_ORIGIN=http://localhost:8080

# =============================================================================
# CORS 配置
# =============================================================================

# 允许的前端域名（JSON 数组格式）
# 开发环境: ["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]
# 生产环境必须配置具体域名，不允许 ["*"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]

# =============================================================================
# 缓存配置
# =============================================================================

# 缓存后端: memory（当前仅支持内存）
CACHE_BACKEND=memory

# Redis 配置（暂未实现，预留）
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USE_TLS=false

# =============================================================================
# 速率限制
# =============================================================================

# 登录失败最大次数
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# 登录锁定时长（秒，15分钟）
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

# 全局速率限制（每分钟请求数）
GLOBAL_RATE_LIMIT_PER_MINUTE=100

# 注册速率限制（每小时每IP次数）
REGISTER_RATE_LIMIT_PER_HOUR=5

# =============================================================================
# 安全配置
# =============================================================================

# bcrypt 哈希轮数
BCRYPT_ROUNDS=12

# 启用安全日志
ENABLE_SECURITY_LOGGING=true

# 可信代理 IP（用于 X-Forwarded-For 验证，生产环境推荐配置）
# 示例: ["10.0.0.1", "172.16.0.0/12"]
TRUSTED_PROXY_IPS=[]

# ALTCHA 验证码 HMAC 密钥（生产环境必填，开发环境自动生成）
ALTCHA_HMAC_KEY=

# =============================================================================
# 文件存储配置
# =============================================================================

# 上传文件目录（默认从 DATA_ROOT 派生: {DATA_ROOT}/workspace）
# 显式设置会覆盖派生值
UPLOAD_DIR=

# 文件同步间隔（分钟）
FILE_SYNC_INTERVAL_MINUTES=15

# 存储后端凭证加密密钥（生产环境推荐独立配置）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# =============================================================================
# 远程存储后端配置（系统级能力）
# =============================================================================
# 支持配置一个远程存储后端用于文件同步备份
# 支持 GitHub 仓库、WebDAV 云盘等远程备份
# 凭证会在启动时加密存储到数据库
# 注意：仅支持配置一个远程存储后端，如需多后端支持请通过数据库直接配置

# 存储后端类型: github / webdav / 空（不配置远程后端）
STORAGE_BACKEND_TYPE=

# 存储后端显示名称（默认使用类型名称）
STORAGE_BACKEND_NAME=

# 是否为默认后端（用于文件同步）
STORAGE_BACKEND_IS_DEFAULT=false

# 是否启用
STORAGE_BACKEND_IS_ACTIVE=true

# GitHub 存储后端配置（当 STORAGE_BACKEND_TYPE=github 时使用）
STORAGE_GITHUB_REPO_OWNER=
STORAGE_GITHUB_REPO_NAME=
STORAGE_GITHUB_BRANCH=main
STORAGE_GITHUB_TOKEN=

# WebDAV 存储后端配置（当 STORAGE_BACKEND_TYPE=webdav 时使用）
STORAGE_WEBDAV_BASE_URL=
STORAGE_WEBDAV_USERNAME=
STORAGE_WEBDAV_PASSWORD=

# =============================================================================
# 聊天配置
# =============================================================================

# 聊天记录存储目录（默认从 DATA_ROOT 派生: {DATA_ROOT}/workspace）
# 不能位于 UPLOAD_DIR 的严格子目录下
CHAT_DIR=

# 启用远程同步（默认关闭，对话历史敏感）
CHAT_ENABLE_REMOTE_SYNC=false

# =============================================================================
# AI Agent 配置
# =============================================================================

# AI 加密密钥（生产环境必填，用于加密 AI API Key）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=

# Agent 内部通信令牌（与 agent 服务共享）
AGENT_INTERNAL_TOKEN=

# Agent 服务内部地址
AGENT_BASE_URL=http://agent:8001

# DeerFlow 配置文件路径（agent 启动时必需）
# 相对于 server/ 目录，指向 deerflow_config 目录下的配置模板
DEER_FLOW_CONFIG_PATH=apps/agent/deerflow_config/base/config.yaml

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志目录（默认从 DATA_ROOT 派生: {DATA_ROOT}/logs）
LOG_DIR=

# 日志文件最大大小（字节，10MB）
LOG_MAX_BYTES=10485760

# 日志备份数量
LOG_BACKUP_COUNT=10

# 日志保留天数
LOG_RETENTION_DAYS=30

# 日志轮转模式: size / time
LOG_ROTATION_MODE=size

# 自定义日志格式（空则使用默认）
LOG_FORMAT=

# =============================================================================
# Snowflake ID 生成器配置
# =============================================================================

# 机器 ID（0-1023），用于分布式部署时避免 ID 冲突
# 不设置时自动从容器内部 IP 推导
# SNOWFLAKE_MACHINE_ID=1