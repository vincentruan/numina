# Numina Production Environment Configuration
# Copy this file to .env and configure for your production environment
#
# 推荐使用 `make setup` 自动生成 .env（含密钥生成 + 数据目录创建）
# 或手动复制: cp .env.production.example .env && 编辑下方配置
# 完整模板参考: .env.examples/.env-production

# =============================================================================
# 核心配置
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# 数据库配置 (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://numina:numinapass@numina-postgres:5432/numina
DEERFLOW_DB_URL=postgresql://numina:numinapass@numina-postgres:5432/numina_deerflow

# PostgreSQL 容器凭据 (docker-compose.yml 中 postgres 服务使用)
POSTGRES_DB=numina
POSTGRES_USER=numina
POSTGRES_PASSWORD=your_strong_postgres_password

# 数据库连接池 (根据实例数调整)
BACKEND_DB_POOL_SIZE=20
BACKEND_DB_MAX_OVERFLOW=5
AGENT_DB_POOL_SIZE=10
AGENT_DB_MAX_OVERFLOW=5
SCHEDULER_DB_POOL_SIZE=5
SCHEDULER_DB_MAX_OVERFLOW=2

# =============================================================================
# Redis 配置（默认启用 — AI 能力依赖 StreamBridge 事件分发 + 共享缓存）
# =============================================================================
# 如需关闭 (纯资产管理, 不使用 AI):
#   1. docker-compose.yml 中注释掉 redis 服务及各服务的 Redis 环境变量
#   2. 将下方 STREAM_BRIDGE_TYPE 改为 memory, CACHE_BACKEND 改为 memory
STREAM_BRIDGE_TYPE=redis
CACHE_BACKEND=redis
REDIS_URL=redis://numina-redis:6379/0

# =============================================================================
# 安全密钥（生产环境必须配置，`make setup` 会自动生成）
# =============================================================================

# JWT 签名密钥（至少 32 字符）
# 生成: openssl rand -hex 32
SECRET_KEY=YOUR_SECRET_KEY_HERE

# 文件存储加密密钥（Fernet 格式）
# 生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=YOUR_STORAGE_ENCRYPTION_KEY_HERE

# AI API Key 加密密钥（Fernet 格式，backend 与 agent 共享）
AI_ENCRYPTION_KEY=YOUR_AI_ENCRYPTION_KEY_HERE

# CAPTCHA 验证密钥
# 生成: openssl rand -hex 32
ALTCHA_HMAC_KEY=YOUR_ALTCHA_HMAC_KEY_HERE

# =============================================================================
# 应用配置
# =============================================================================

# CORS 允许的域名（JSON 数组格式，生产环境不可为 ["*"]）
CORS_ORIGINS=["https://numina.example.com"]

# JWT 令牌过期时间
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据目录
NUMINA_DATA_DIR=./.numina/data

# Snowflake ID 机器编号 (0-1023, 多实例部署时每个实例需不同)
SNOWFLAKE_MACHINE_ID=1

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 时区
TZ=Asia/Shanghai

# =============================================================================
# AI 配置
# =============================================================================
# AI_MODEL=gpt-4o
# AI_API_KEY=your-api-key

# =============================================================================
# 可选功能
# =============================================================================

# 文件同步间隔 (分钟)
# FILE_SYNC_INTERVAL_MINUTES=30

# 跳过启动时汇率获取
# SKIP_INITIAL_EXCHANGE_RATE_FETCH=true

# Short.io 短链接（家庭邀请码分享功能）
# SHORTIO_API_KEY=
# SHORTIO_DOMAIN=

# 家庭邀请码（首次部署后生成）
# INIT_INVITATION_CODES=
# 或部署后运行 `make setup-invitation-codes` 动态生成

# =============================================================================
# 端口映射 (可选, 默认值如注释)
# =============================================================================
# BACKEND_PORT=28000
# AGENT_PORT=28001
# WORKER_PORT=28002
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# =============================================================================
# 预构建镜像 (GHCR, 用于 deploy-images)
# =============================================================================
# BACKEND_IMAGE=ghcr.io/vincentruan/numina/backend:latest
# AGENT_IMAGE=ghcr.io/vincentruan/numina/agent:latest
# SCHEDULER_WORKER_IMAGE=ghcr.io/vincentruan/numina/scheduler-worker:latest
# FRONTEND_MAIN_IMAGE=ghcr.io/vincentruan/numina/frontend-main:latest
# FRONTEND_CHILD_IMAGE=ghcr.io/vincentruan/numina/frontend-child:latest
