# Numina Production Environment Configuration
# Copy this file to .env and configure for your production environment
# This file is used by docker-compose.yml to configure both backend and agent services.

# =============================================================================
# Core Environment Settings
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# Security & Encryption Keys (REQUIRED IN PRODUCTION)
# Generate a strong random key for each using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# or for standard secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# Django/FastAPI Secret Key (Minimum 32 characters)
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Database URL - SQLite for simplicity, use MySQL/PostgreSQL in real production
DATABASE_URL=sqlite:////app/data/numina.db

# Storage Encryption Key (Required in production)
STORAGE_ENCRYPTION_KEY=YOUR_STORAGE_ENCRYPTION_KEY_HERE

# AI API Key Encryption (Shared between backend and agent)
AI_ENCRYPTION_KEY=YOUR_AI_ENCRYPTION_KEY_HERE

# Agent <-> Backend Internal Communication Token
AGENT_INTERNAL_TOKEN=YOUR_AGENT_INTERNAL_TOKEN_HERE

# CAPTCHA HMAC Key
ALTCHA_HMAC_KEY=YOUR_ALTCHA_HMAC_KEY_HERE

# =============================================================================
# Application Settings
# =============================================================================

# CORS - Configure your domain(s) (Must NOT be ["*"] in production)
CORS_ORIGINS=["https://numina.example.com"]

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Workspace path (inside docker container)
WORKSPACE_ROOT=/app/data/workspace

# =============================================================================
# Optional DB Credentials (if using --profile mysql or postgres in docker-compose)
# =============================================================================
# MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password
# MYSQL_DATABASE=numina
# MYSQL_USER=numina
# MYSQL_PASSWORD=your_strong_mysql_password

# POSTGRES_DB=numina
# POSTGRES_USER=numina
# POSTGRES_PASSWORD=your_strong_postgres_password