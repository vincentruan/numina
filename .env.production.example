# Numina Production Environment Configuration
# Copy this file to .env and configure for your production environment
#
# 推荐使用 `make setup` 自动生成 .env（含密钥生成 + 数据目录创建）
# 或手动复制: cp .env.production.example .env && 编辑下方配置

# =============================================================================
# 核心配置
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# 数据库配置
# =============================================================================
# 默认使用 SQLite（零配置，适合小规模部署）
DATABASE_URL=sqlite:////app/.numina/data/db/numina.db
#
# 如需使用 MySQL（先运行 `make setup-db-mysql`）:
# DATABASE_URL=mysql+pymysql://numina:numinapass@numina-mysql:3306/numina
#
# 如需使用 PostgreSQL（先运行 `make setup-db-postgres`）:
# DATABASE_URL=postgresql+psycopg://numina:numinapass@numina-postgres:5432/numina

# =============================================================================
# 安全密钥（生产环境必须配置，`make setup` 会自动生成）
# =============================================================================

# JWT 签名密钥（至少 32 字符）
# 生成: openssl rand -hex 32
SECRET_KEY=YOUR_SECRET_KEY_HERE

# 文件存储加密密钥（Fernet 格式）
# 生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=YOUR_STORAGE_ENCRYPTION_KEY_HERE

# AI API Key 加密密钥（Fernet 格式，backend 与 agent 共享）
# 生成: 同上
AI_ENCRYPTION_KEY=YOUR_AI_ENCRYPTION_KEY_HERE

# Backend ↔ Agent 内部通信令牌
# 生成: openssl rand -hex 32
AGENT_BASE_URL=http://numina-agent:8001

# CAPTCHA 验证密钥
# 生成: openssl rand -hex 32
ALTCHA_HMAC_KEY=YOUR_ALTCHA_HMAC_KEY_HERE

# =============================================================================
# 应用配置
# =============================================================================

# CORS 允许的域名（JSON 数组格式，生产环境不可为 ["*"]）
CORS_ORIGINS=["https://numina.example.com"]

# JWT 令牌过期时间
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 容器内工作空间路径
WORKSPACE_ROOT=/app/data/workspace

# =============================================================================
# 家庭邀请码（首次部署后生成）
# =============================================================================
# 生产环境需要邀请码才能注册新用户
# 方式一：在此处填写初始邀请码（逗号分隔）
INIT_INVITATION_CODES=
# 方式二：部署后运行 `make setup-invitation-codes` 动态生成

# =============================================================================
# Short.io 短链接（家庭邀请码分享功能）
# =============================================================================
# 在 short.io 注册并添加自定义域名后，获取 API Key
# 配置后 /family 页面将显示「分享邀请」按钮，生成短链接 + 二维码
SHORTIO_API_KEY=
SHORTIO_DOMAIN=

# =============================================================================
# 可选：MySQL/PostgreSQL 凭据（使用对应 DB 时取消注释）
# =============================================================================
# MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password
# MYSQL_DATABASE=numina
# MYSQL_USER=numina
# MYSQL_PASSWORD=your_strong_mysql_password

# POSTGRES_DB=numina
# POSTGRES_USER=numina
# POSTGRES_PASSWORD=your_strong_postgres_password