# Numina Production Environment Configuration
# Copy this file to .env.production and configure for your environment

# Security - Generate a strong random key
# Run: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YOUR_SECRET_KEY_HERE
ENVIRONMENT=production

# CORS - Configure your domain(s)
CORS_ORIGINS=["https://numina.example.com"]

# Database - SQLite for simplicity
DATABASE_URL=sqlite:////app/data/numina.db

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7