# PageAgent E2E Configuration
# Copy to .env and fill in real values. Never commit .env itself.
#
# Priority: shell env > runner .env > skill .env > defaults
# See README.md for full setup instructions.

# ──────────────────────────────────────────────────────────────
# Required — PageAgent LLM Provider
# ──────────────────────────────────────────────────────────────
# The LLM that drives semantic DOM interaction.
# Recommended: gpt-4o (best accuracy/cost tradeoff for DOM navigation).
# Compatible: any OpenAI-compatible API (Azure OpenAI, Deepseek, etc.)

PAGE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
PAGE_AGENT_LLM_MODEL=gpt-4o
PAGE_AGENT_LLM_API_KEY=sk-YOUR_API_KEY_HERE

# ──────────────────────────────────────────────────────────────
# Required — Test Credentials
# ──────────────────────────────────────────────────────────────
# Pre-seeded test user in the backend database.
# These must exist before running tests — create via API or seed script.

E2E_TEST_USER=test_rich
E2E_TEST_PASSWORD=YOUR_TEST_PASSWORD_HERE

# Child app credentials (emoji PIN, comma-separated)
E2E_CHILD_USER=test_child
E2E_CHILD_PIN=🐱,🐶,🌟,🌈

# ──────────────────────────────────────────────────────────────
# Optional — Target Application URLs
# ──────────────────────────────────────────────────────────────
# Where the apps are running. Defaults work for local dev servers.
# For Docker: use http://localhost:8080 (nginx proxy)

PAGE_AGENT_BASE_URL=http://localhost:5173
PAGE_AGENT_CHILD_BASE_URL=http://localhost:5174
PAGE_AGENT_BACKEND_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────────
# Optional — Runner Behavior
# ──────────────────────────────────────────────────────────────

# Language for PageAgent system prompt (zh-CN | en)
PAGE_AGENT_LANGUAGE=zh-CN

# Show headed browser for debugging (0=headless, 1=headed)
PAGE_AGENT_DEBUG=0

# Delay between PageAgent steps in seconds (lower = faster, higher = more stable)
# CI recommended: 0.1 | Local recommended: 0.3
PAGE_AGENT_STEP_DELAY=0.3

# Skip starting dev servers (set to 1 if services are already running)
PAGE_AGENT_E2E_SKIP_START=0
