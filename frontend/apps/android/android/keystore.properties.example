# Release signing credentials for the Numina Android shell.
#
# Copy this file to keystore.properties (same directory) and fill in real
# values. keystore.properties is gitignored — never commit real credentials.
#
# Create a keystore with:
#   keytool -genkeypair -v -keystore numina-release.jks \
#     -alias numina -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile may be absolute or relative to the android/ project directory.

storeFile=numina-release.jks
storePassword=CHANGE_ME
keyAlias=numina
keyPassword=CHANGE_ME
