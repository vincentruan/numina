{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest",
    "test:run": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.vitest.json"
  },
  "dependencies": {
    "@iconify/json": "^2.2.508",
    "@iconify/vue": "^4.3.0",
    "@langchain/langgraph-sdk": "^1.9.22",
    "@numina/auth": "workspace:*",
    "@numina/math": "workspace:*",
    "@types/nprogress": "^0.2.3",
    "@vant/touch-emulator": "^1.5.0",
    "axios": "^1.13.6",
    "dompurify": "^3.4.1",
    "echarts": "^6.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "markdown-it": "^14.2.0",
    "marked": "^18.0.2",
    "nanoid": "^3.3.11",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "shiki": "^4.2.0",
    "vant": "^4.9.22",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.1",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.0",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.0",
    "vite-plugin-svg-icons-ng": "^1.0.4",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.5"
  }
}
