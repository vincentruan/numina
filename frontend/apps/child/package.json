    "@numina/auth": "workspace:*",
    "@numina/math": "workspace:*",
    "@vant/touch-emulator": "^1.5.0",
    "axios": "^1.13.6",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vant": "^4.9.22",
    "vue": "^3.5.30",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/nprogress": "^0.2.3",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^17.6.3",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.0",
