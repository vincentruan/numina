# ═══════════════════════════════════════════════════════════
# server/.env — 本地开发专用 (make dev-backend / dev-agent / dev-worker)
# 与根 .env 的区别: 使用 localhost (非 Docker 服务名)
#
# 用法: cp .env.examples/server.env.dev server/.env
#
# SQLite: 修改 DATABASE_URL 为本地路径, 注释掉 DEERFLOW_DB_URL
# PostgreSQL: 使用下方默认值 (需先启动 PostgreSQL)
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# ── 数据库 ──
# PostgreSQL (默认):
DATABASE_URL=postgresql://numina:numinapass@localhost:5432/numina
DEERFLOW_DB_URL=postgresql://numina:numinapass@localhost:5432/numina_deerflow
#
# SQLite (取消注释, 替换 YOUR_USERNAME):
# DATABASE_URL=sqlite:////Users/YOUR_USERNAME/.numina/data/db/numina.db
# DEERFLOW_DB_URL 不需要 — agent 自动回退到内存存储

# ── 服务地址 (本地直连, 非 Docker 服务名) ──
AGENT_BASE_URL=http://localhost:8001
BACKEND_BASE_URL=http://localhost:8000

# ── CORS (包含 Vite dev server 端口) ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8080","http://localhost:28080"]

# ── 安全密钥 (务必替换) ──
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# ── Token ──
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Agent ──
AGENT_INTERNAL_TOKEN=local-test-agent-token-dev

# ── DeerFlow config path (agent service) ──
DEER_FLOW_CONFIG_PATH=apps/agent/deerflow_config/base/config.yaml

# ── 可选 ──
# LOG_LEVEL=DEBUG
# GLOBAL_RATE_LIMIT_PER_MINUTE=600
# AI_MODEL=gpt-4o
# AI_API_KEY=your-api-key
