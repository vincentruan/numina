# ═══════════════════════════════════════════════════════════
# 场景: 开发/测试部署 (SQLite, 无 Redis)
# 前提: 使用 docker-compose.dev.yml 部署, 无需外部数据库
# 用法: cp .env.examples/.env-dev .env
# 启动: docker compose -f docker-compose.dev.yml up -d --build
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# ── 数据库 (SQLite — 零配置) ──
DATABASE_URL=sqlite:////app/.numina/data/db/numina.db

# ── 安全密钥 (开发默认值, 生产环境必须替换!) ──
SECRET_KEY=dev-secret-key-change-in-production
ALTCHA_HMAC_KEY=dev-altcha-key
# Fernet 格式 base64 编码密钥 (开发用)
AI_ENCRYPTION_KEY=dGV2LWFlcy1rZXktY2hhbmdlLWluLXByb2Q=
STORAGE_ENCRYPTION_KEY=dGV2LXN0b3JhZ2Uta2V5LWNoYW5nZS1pbi1wcm9k

# ── 开发配置 ──
DISABLE_CAPTCHA=true
CORS_ORIGINS=["http://localhost:28080","http://localhost:80","http://localhost:5173","http://localhost:5174"]
LOG_LEVEL=DEBUG

# ── 数据目录 ──
NUMINA_DATA_DIR=./.numina/data

# ── Agent (SQLite 模式下 DeerFlow 使用内存 checkpointer) ──
# AI_MODEL=placeholder
# AI_API_KEY=placeholder
