# ═══════════════════════════════════════════════════════════
# 场景: 本地开发 + 远程 PostgreSQL
# 前提: PostgreSQL 运行在远程服务器 (如 RDS / Cloud SQL / VPS)
# 用法: cp .env.examples/.env.dev-pgsql-remote .env && cp .env.examples/.env.dev-pgsql-remote server/.env
# 启动: make dev-all
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# 数据库 — 远程 PostgreSQL
# 替换 <HOST> <PORT> <PASSWORD> 为你的远程 PostgreSQL 地址
DATABASE_URL=postgresql://numina:YOUR_PASSWORD@<HOST>:5432/numina

# DeerFlow checkpoint DB — 远程 PostgreSQL
DEERFLOW_DB_URL=postgresql://numina:YOUR_PASSWORD@<HOST>:5432/numina_deerflow

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8080"]

# 安全密钥 (务必替换)
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# 服务地址
AGENT_BASE_URL=http://localhost:8001
BACKEND_BASE_URL=http://localhost:8000

# Token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent
AGENT_INTERNAL_TOKEN=local-test-agent-token-dev
