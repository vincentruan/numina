# ═══════════════════════════════════════════════════════════
# 场景: 本地开发 + SQLite
# 用法: cp .env.examples/.env.dev-sqlite .env && cp .env.examples/.env.dev-sqlite server/.env
# 启动: make dev-all (或 make dev-backend + make dev-frontend)
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# 数据库 — SQLite (自动创建，无需额外配置)
DATABASE_URL=sqlite:////Users/YOUR_USERNAME/.numina/data/db/numina.db

# CORS — 本地 Vite dev server 端口
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8080"]

# 安全密钥 (务必替换为随机值: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# 服务地址 (本地直连)
AGENT_BASE_URL=http://localhost:8001
BACKEND_BASE_URL=http://localhost:8000

# Token 过期
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent (SQLite 模式下 DeerFlow 使用内存 checkpointer)
AGENT_INTERNAL_TOKEN=local-test-agent-token-dev
# DEERFLOW_DB_URL 不需要 — agent 自动回退到内存存储

# 可选: Tavily Web Search
# TAVILY_API_KEY=your-key-here
