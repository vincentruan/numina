# ═══════════════════════════════════════════════════════════
# 场景: Docker 部署 + 远程/宿主机 PostgreSQL
# 前提: PostgreSQL 运行在宿主机或远程服务器 (非 docker-compose 管理)
# 用法: cp .env.examples/.env.docker-pgsql-host .env
# 启动: make up (需确保宿主机 PostgreSQL 允许 Docker 网桥访问)
# 访问: http://localhost
#
# 关键: host.docker.internal 通过 docker-compose.yml 的 extra_hosts 映射
#       到宿主机网关。Linux 需要 Docker 20.10+。
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# 数据库 — 宿主机/远程 PostgreSQL
# host.docker.internal 解析到宿主机 IP (由 extra_hosts 配置)
DATABASE_URL=postgresql://numina:numinapass@host.docker.internal:5432/numina

# DeerFlow checkpoint DB — 宿主机/远程 PostgreSQL
DEERFLOW_DB_URL=postgresql://numina:numinapass@host.docker.internal:5432/numina_deerflow

# CORS
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:28080"]

# 安全密钥 (务必替换)
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# Token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent
AGENT_INTERNAL_TOKEN=local-test-agent-token-dev
