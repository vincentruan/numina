# ═══════════════════════════════════════════════════════════
# 场景: Docker 部署 + PostgreSQL 容器 (同一 docker-compose 网络)
# 前提: 使用 docker-compose.yml 内置的 postgres 服务 (profiles: postgres)
# 用法: cp .env.examples/.env.docker-pgsql-docker .env
# 启动: make up-postgres (自动启动 postgres 容器 + 创建数据库)
# 访问: http://localhost
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# 数据库 — Docker PostgreSQL 容器
# 容器名: numina-postgres, 网络内直接解析
# 注意: 当 .env 设置此值时，会覆盖 docker-compose.yml 的默认值
DATABASE_URL=postgresql://numina:numinapass@numina-postgres:5432/numina

# DeerFlow checkpoint DB — Docker PostgreSQL 容器
DEERFLOW_DB_URL=postgresql://numina:numinapass@numina-postgres:5432/numina_deerflow

# CORS
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:28080"]

# 安全密钥 (务必替换)
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# Token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent
AGENT_INTERNAL_TOKEN=local-test-agent-token-dev

# PostgreSQL 凭据 (postgres 容器使用)
POSTGRES_DB=numina
POSTGRES_USER=numina
POSTGRES_PASSWORD=numinapass
