# ═══════════════════════════════════════════════════════════
# 场景: 标准部署 (生产/测试/本地 PostgreSQL 验证)
# 前提: 使用 docker-compose.yml 部署, PostgreSQL 容器始终包含
# 用法: cp .env.examples/.env-production .env
# 启动: docker compose up -d --build
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=production

# ── 数据库 (PostgreSQL) ──
DATABASE_URL=postgresql://numina:numinapass@numina-postgres:5432/numina
DEERFLOW_DB_URL=postgresql://numina:numinapass@numina-postgres:5432/numina_deerflow

# PostgreSQL 容器凭据
POSTGRES_DB=numina
POSTGRES_USER=numina
POSTGRES_PASSWORD=numinapass

# 数据库连接池 (根据实例数调整)
BACKEND_DB_POOL_SIZE=20
BACKEND_DB_MAX_OVERFLOW=5
AGENT_DB_POOL_SIZE=10
AGENT_DB_MAX_OVERFLOW=5
SCHEDULER_DB_POOL_SIZE=5
SCHEDULER_DB_MAX_OVERFLOW=2

# ── Redis (默认启用, AI 能力依赖) ──
# 如需关闭 (纯资产管理, 不使用 AI):
#   1. docker-compose.yml 中注释掉 redis 服务及各服务的 Redis 环境变量
#   2. 将 STREAM_BRIDGE_TYPE 改为 memory, CACHE_BACKEND 改为 memory
STREAM_BRIDGE_TYPE=redis
CACHE_BACKEND=redis
REDIS_URL=redis://numina-redis:6379/0

# ── 安全密钥 (务必替换为随机值) ──
# 生成: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
# 生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# ── 应用配置 ──
CORS_ORIGINS=["https://numina.example.com"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 数据目录 ──
NUMINA_DATA_DIR=./.numina/data

# ── Snowflake ID ──
SNOWFLAKE_MACHINE_ID=1

# ── 日志/时区 ──
LOG_LEVEL=INFO
# TZ=Asia/Shanghai

# ── AI 配置 ──
# AI_MODEL=gpt-4o
# AI_API_KEY=your-api-key

# ── 可选功能 ──
# FILE_SYNC_INTERVAL_MINUTES=30
# SKIP_INITIAL_EXCHANGE_RATE_FETCH=true
# SHORTIO_API_KEY=
# SHORTIO_DOMAIN=
# INIT_INVITATION_CODES=

# ── 端口映射 (可选) ──
# BACKEND_PORT=28000
# AGENT_PORT=28001
# WORKER_PORT=28002
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# ── 预构建镜像 (GHCR, 可选) ──
# BACKEND_IMAGE=ghcr.io/vincentruan/numina/backend:latest
# AGENT_IMAGE=ghcr.io/vincentruan/numina/agent:latest
# SCHEDULER_WORKER_IMAGE=ghcr.io/vincentruan/numina/scheduler-worker:latest
# FRONTEND_MAIN_IMAGE=ghcr.io/vincentruan/numina/frontend-main:latest
# FRONTEND_CHILD_IMAGE=ghcr.io/vincentruan/numina/frontend-child:latest
