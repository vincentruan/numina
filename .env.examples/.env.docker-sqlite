# ═══════════════════════════════════════════════════════════
# 场景: Docker 部署 + SQLite
# 用法: cp .env.examples/.env.docker-sqlite .env
# 启动: make deploy-dev (开发模式+种子数据) 或 make up (生产模式)
# 访问: http://localhost
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development

# 数据库 — SQLite (容器内路径)
DATABASE_URL=sqlite:////app/.numina/data/db/numina.db

# CORS — Docker nginx 端口
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:28080"]

# 安全密钥 (务必替换: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_KEY
AI_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
STORAGE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_2

# Token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent (SQLite 模式下 DeerFlow 使用内存 checkpointer)
AGENT_INTERNAL_TOKEN=local-test-agent-token-dev
# DEERFLOW_DB_URL 不需要
