# Numina Environment Configuration
# Copy this file to .env and customize for your environment

# JWT Secret Key (REQUIRED in production - use a long random string)
SECRET_KEY=your-secret-key-change-me-in-production-use-at-least-32-characters

# Database URL (default: SQLite)
# For SQLite: sqlite:////app/data/numina.db
# For MySQL: mysql+pymysql://numina:numinapass@mysql:3306/numina
# For PostgreSQL: postgresql+psycopg2://numina:numinapass@postgres:5432/numina
DATABASE_URL=sqlite:////app/data/numina.db

# Environment mode
ENVIRONMENT=production

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:80","http://localhost:28080"]

# JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent Configuration
AI_ENCRYPTION_KEY=20addd319dced9c7c61437189faafb60db801d952e4fe238013cd7d634b297e5
AGENT_INTERNAL_TOKEN=3acc46c1e8247741be261734167a181ceaad74c4bf1a38f95598ea470689569e

# Storage Encryption (Fernet key - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
STORAGE_ENCRYPTION_KEY=U2OhO-cmBrNvf2D7wMY9ArPBxJr6hL8Ye14lrP3FM-M=

# Optional: MySQL/PostgreSQL credentials (used with --profile mysql/postgres)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=numina
MYSQL_USER=numina
MYSQL_PASSWORD=numinapass
POSTGRES_DB=numina
POSTGRES_USER=numina
POSTGRES_PASSWORD=numinapass

# Altcha HMAC Key (for CAPTCHA)
ALTCHA_HMAC_KEY=2b794ee200fb900efe63925ae5ce238c674add2f95131ff907ac024aa8c6d79d